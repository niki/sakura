// 正規表現キーワード Ver1
RxKey[000]=CMT,/<!--.*?-->/k
RxKey[001]=CMT,/<!--[^\r\n]*/k
RxKey[002]=CMT,/<!\[CDATA\[[^\r\n]?*\]\]>/k
RxKey[003]=CMT,/<!\[CDATA\[[^\r\n]*/k
RxKey[004]=RK1,/<\/(?=[^!?a-z\/])/ki
RxKey[005]=RK1,/<(?=[^!?a-z\/])/ki
RxKey[006]=RK2,/<\/|<|\/>|>/k
RxKey[007]=RK3,/(?<=<)[a-z][a-z0-9_:\-]*/ki
RxKey[008]=RK3,/(?<=<\/)[a-z][A-Za-z0-9_:\-]*(?=>)/ki
RxKey[009]=RK4,/\b[a-z][a-z0-9_:\-]+(?==')/ki
RxKey[010]=RK4,/\b[a-z][a-z0-9_:\-]+(?==")/ki
RxKey[011]=RK5,/&(([a-z]{1,9})|(#((x[0-9a-f]{1,8})|([0-9]{1,12}))));/ki
RxKey[012]=RK1,/&/k
