// ============================================================================
// lang_strings.h.sample (en-us)
//
// String macro placeholder (not wired into the build yet).
// English counterpart of the LANG_* macros consumed by
// ../common/sakura_rc_body.rc.sample. Text taken as-is from the existing
// sakura_lang_en_US/sakura_lang_rc.rc IDD_JUMP block.
//
// When the real migration happens, this file (and jp-ja/lang_strings.h) will
// be generated from a diff between sakura_rc.rc and sakura_lang_rc.rc rather
// than hand-written, since there are ~940 string IDs and ~2300 dialog text
// literals to cover.
// ============================================================================

